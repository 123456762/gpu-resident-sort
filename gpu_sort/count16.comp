/* MSD 高16位直方图: count[65536]++ (每桶=高16位) —— 2026-10-20 补缺(E3209)
 * 对应宿主 vulkan_radix_sort.c 的 stage 1:
 *   descriptor set0: binding0=data(uint[]), binding1=count(uint[65536]), binding2=wpos(aux,不用)
 *   push constants: {uint shift; uint n}  (shift 固定 16)
 * 说明: 65536 桶放不进 shared(256KB) ⟹ 直接 global atomicAdd（正确优先；宿主侧 MSD 可后续优化成
 *       每 workgroup 分段直方图 + 二次归并，但那是性能优化，不是正确性前提）。
 */
#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer InBuf  { uint data[]; };
layout(set = 0, binding = 1, std430) buffer        CountBuf { uint count[]; };
layout(set = 0, binding = 2, std430) buffer        AuxBuf   { uint aux[]; };

layout(push_constant) uniform PC { uint shift; uint n; uint mask; uint unused; uint sub; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    uint key = data[i] - pc.sub;  /* ★[E3221] 与 scatter 同口径：先减最小值 */
    uint b   = (key >> pc.shift) & pc.mask;     /* 高位桶（bits 随 n 自适应） */
    atomicAdd(count[b], 1u);
}
