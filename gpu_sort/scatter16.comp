/* MSD 高16位 scatter 到 pad 布局(桶b的256槽 = b*256+桶内偏移) —— 2026-09-01 */
#version 450
layout(local_size_x = 256) in;
layout(set=0, binding=0, std430) readonly buffer InBuf { uint data[]; };
layout(set=0, binding=1, std430) buffer OutBuf { uint odata[]; };
layout(set=0, binding=2, std430) buffer WposBuf { uint wpos[]; };
layout(push_constant) uniform PC { uint shift; uint n; uint mask; uint slots; uint sub; } pc;
void main(){
    uint i = gl_GlobalInvocationID.x;
    if(i >= pc.n) return;
    uint key = data[i] - pc.sub;  /* ★[E3221] 先减最小值 */
    uint b = (key >> pc.shift) & pc.mask;
    uint slot = atomicAdd(wpos[b], 1u);   /* 桶内偏移(0起) */
    odata[b * pc.slots + slot] = data[i];     /* pad 布局：每桶 slots 槽，bitonic 每桶 workgroup */
}
